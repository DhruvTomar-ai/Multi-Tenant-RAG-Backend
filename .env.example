DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5433/DATABASE_NAME
APP_ENV=development

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

CELERY_BROKER_URL=redis://localhost:6379/0

DOCUMENT_STORAGE_ROOT=./data/documents
MAX_UPLOAD_SIZE_MB=25
MAX_DOCX_UNCOMPRESSED_MB=200
ALLOWED_DOCUMENT_EXTENSIONS=[".pdf",".docx",".txt"]

# Counted by the chunker's tokenizer, which differs from BGE's. 300 keeps the longest measured chunk
# under BGE's 512-token limit. Run benchmarks/chunk_size_check.py before raising it.
CHUNK_SIZE=300
CHUNK_OVERLAP=64

# Applies to temporary failures only. Permanent failures are never retried.
INGESTION_MAX_RETRIES=3
INGESTION_RETRY_BACKOFF_SECONDS=30

# Embeddings. The column is vector(384), so changing the model's dimension needs a migration.
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
EMBEDDING_CACHE_DIR=./models
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BACKOFF_SECONDS=30

# Applied per query with SET LOCAL.
HNSW_EF_SEARCH=100
HNSW_ITERATIVE_SCAN=strict_order
HNSW_MAX_SCAN_TUPLES=20000
HNSW_SCAN_MEM_MULTIPLIER=1

SEARCH_DEFAULT_TOP_K=5
SEARCH_MAX_TOP_K=50
SEARCH_MAX_OFFSET=200

# Answer generation. Without a key, questions that would need the LLM get a 503.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=2048
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2

RAG_TOP_K=5
# Compared with similarity_score (1 - cosine distance). Run benchmarks/relevance_threshold.py with
# text from your own documents before changing it.
RAG_MIN_SIMILARITY=0.50
RAG_MAX_CONTEXT_TOKENS=3000
RAG_HISTORY_MESSAGES=6
RAG_MAX_HISTORY_TOKENS=1000
RAG_RETRIEVAL_HISTORY_QUESTIONS=1
