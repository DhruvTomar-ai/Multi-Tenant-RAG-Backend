# Where the Vite dev and preview servers forward /api. This is not sent to the browser.
API_PROXY_TARGET=http://127.0.0.1:8000

# Shown to users and checked before upload. The backend still enforces its own limits,
# so keep these matched to MAX_UPLOAD_SIZE_MB and ALLOWED_DOCUMENT_EXTENSIONS.
VITE_MAX_UPLOAD_MB=25
VITE_ALLOWED_EXTENSIONS=.pdf,.docx,.txt
